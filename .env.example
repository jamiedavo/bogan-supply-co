# Keep false until products, prices, imagery, delivery, taxes, and policies are approved.
SHOPIFY_CHECKOUT_ENABLED=false
# Original myshopify.com domain; checkout URLs must use this domain.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Public Storefront API access token (never an Admin API token).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
